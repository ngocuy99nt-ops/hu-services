# Resend (https://resend.com) — dùng để gửi email thông báo khi có người điền form Liên hệ
RESEND_API_KEY=

# Email sẽ nhận thông báo (nên trùng với email đã đăng ký tài khoản Resend
# nếu chưa verify domain riêng — xem README/hướng dẫn đi kèm)
CONTACT_TO_EMAIL=
# Tùy chọn: địa chỉ "From" hiển thị trong email gửi đi
CONTACT_FROM_EMAIL=
